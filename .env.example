# Copy this file to `.env` and fill in values for your machine.
# `.env` is git-ignored: never commit real API keys.

# Required by VS Code / some tools so root packages (fusion, adapters) import cleanly.
PYTHONPATH=.

# --- Optional: live LLM explanation providers (fusion/llm_explainer.py) ---
# If unset, the explainer automatically falls back to the offline
# deterministic rule-based engine. No key is required to run the system.
# GEMINI_API_KEY=your_google_gemini_key
# OPENAI_API_KEY=your_openai_key

# --- Optional: domain_intelligence overrides (src/config.py) ---
# PHISHING_PRIMARY_DATASET=path/to/phishing.csv
# PHISHING_CROSS_DATASET=path/to/raw_data.csv
# PHISHING_MODEL_PATH=path/to/xgboost_url_model.joblib
# PHISHING_EXPLAINER_PATH=path/to/shap_url_explainer.joblib
# PHISHING_DOMAIN_INTEL=1
